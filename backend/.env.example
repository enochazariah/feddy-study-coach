# Server-side only. Never commit this file with real values.
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave DATABASE_URL unset for local SQLite. With DEBUG=True, settings.py uses
# backend/data/feddy_study.db. sqlite:///db.sqlite3 resolves to /db.sqlite3
# on Windows, outside the project data directory.
# DATABASE_URL=sqlite:///db.sqlite3
SESSION_JWT_SECRET=your_jwt_secret_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Google OAuth client ID required by backend/config/settings.py.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
YOUTUBE_API_KEY=your-youtube-data-api-key
ALLOW_DEMO_LOGIN=False
DEMO_LOGIN_EMAIL=demo@example.com
TAVILY_API_KEY=your-tavily-api-key
